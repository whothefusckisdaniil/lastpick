# STRATZ GraphQL API token — required by scripts/update-data-stratz.mjs (npm run update:data)
# and by the CI workflow .github/workflows/update-data.yml (as the STRATZ_API_TOKEN secret).
# Get a free Default Token: log in with Steam at https://stratz.com/api → "My Tokens".
STRATZ_API_TOKEN=

# Product analytics (PostHog Free). The project API key is public (phc_…), it ships in the bundle.
# Without it the site works and sends no product events. Host: https://us.i.posthog.com or https://eu.i.posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
